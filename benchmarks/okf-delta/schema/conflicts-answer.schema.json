        "Conflict due to outdated information",
        "Conflict due to misinformation"
      ]
    },
    "answer": { "type": "string" },
    "evidence_source_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reason": { "type": "string" }
  }
}
